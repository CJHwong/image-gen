#!/usr/bin/env bash
# flux2 - wrapper for uncensored FLUX.2 klein-base-9B generation through mflux
# (Python-MLX, the PEP 723 script mflux_gen.py). Forwards every arg verbatim.
# Run `flux2 help` for usage, model setup and flags.

set -eu

# realpath follows the ~/.local/bin symlink, so mflux_gen.py is found.
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
gen="$script_dir/mflux_gen.py"

usage() {
    cat <<'EOF'
flux2 - uncensored FLUX.2 klein-base-9B + uncensored Qwen3-8B encoder, via mflux

Text-to-image by default; --input switches to i2i editing. It downloads
nothing: the model dir must exist first (see MODEL).

MODEL (one-time, ~33 GB)
  mflux reads one diffusers-layout dir. Its name must contain "klein-base-9b".
  Default: ~/Library/Caches/models/mflux-klein-base-9b-uncensored
  (override with --model-dir or FLUX2_MFLUX_MODEL_DIR).

  1. Everything except the encoder weights comes from the uncensored
     transformer repo (not gated, flux-non-commercial-license):
       M=~/Library/Caches/models/mflux-klein-base-9b-uncensored
       SRC=https://huggingface.co/darknight9121/FLUX.2-klein-base-9B-bucket-uncensored/resolve/main
       for f in model_index.json scheduler/scheduler_config.json \
                text_encoder/config.json text_encoder/generation_config.json \
                tokenizer/{added_tokens.json,chat_template.jinja,merges.txt} \
                tokenizer/{special_tokens_map.json,tokenizer.json,tokenizer_config.json,vocab.json} \
                transformer/config.json transformer/diffusion_pytorch_model.safetensors.index.json \
                transformer/diffusion_pytorch_model-0000{1,2}-of-00002.safetensors \
                vae/config.json vae/diffusion_pytorch_model.safetensors; do
         curl -L -C - --create-dirs "$SRC/$f" -o "$M/$f"
       done
  2. The encoder weights come from the uncensored encoder repo. It is gated:
     accept its conditions on the HF page, then pass a HuggingFace token:
       E=~/Library/Caches/models/ponpoke-uncensored-qwen3-8b
       curl -L -C - --create-dirs -H "Authorization: Bearer $HF_TOKEN" \
         https://huggingface.co/ponpoke/flux2-klein-9b-uncensored-text-encoder/resolve/main/model.safetensors \
         -o "$E/model.safetensors"
       ln -s "$E/model.safetensors" "$M/text_encoder/model.safetensors"
     Fetch only model.safetensors; the .gguf files there are for llama.cpp.

DEFAULTS
  25 steps, guidance 4.0, int8 (-q 8), 256x256 for t2i, input size for i2i.
  One size flag alone makes a square. No --seed means a random seed; the
  run header prints it so you can reproduce the image.

OUTPUT
  --output (default ./uncensored_test.png). With --count N, mflux adds the seed
  to each name: apple.png -> apple_seed_<n>.png. Seeds increment from --seed.
  i2i regenerates from noise conditioned on the reference; it does not keep
  the input pixels, and there is no strength knob.

EXAMPLES
  flux2 --prompt "a beaver building a dam, golden hour" --width 512 --output out.png
  flux2 --prompt "new hairstyle, undercut" --input ref.png --output out.png --seed 7
  flux2 --prompt "a red apple" --count 4 --output apple.png

EOF
    # FLAGS come from the script's own --help, so the list never drifts.
    uv run -q "$gen" --help | sed -n '/^options:/,$p'
}

case "${1:-}" in
    help|--help|-h) usage; exit 0 ;;
esac

exec uv run "$gen" "$@"
