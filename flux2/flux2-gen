#!/usr/bin/env bash
# flux2-gen - interactive flux2 wrapper: ask for a prompt, write a
# timestamped PNG in the current directory. Extra flags pass through
# (e.g. --input ref.png for i2i, --steps 12 for a quick draft).
set -eu

# realpath follows the ~/.local/bin symlink, so the sibling `flux2` is found.
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
flux2="$script_dir/flux2"

case "${1:-}" in
    help|--help|-h)
        cat <<'HELP'
flux2-gen - interactive flux2: prompts for a prompt, writes a timestamped PNG
            (flux2_YYYYMMDD_HHMMSS.png) in the current directory.

USAGE
    flux2-gen [extra flux2 flags...]

Extra flags pass straight through to flux2, e.g.:
    flux2-gen --input ref.png            # image-to-image
    flux2-gen --steps 12 --seed 7        # override defaults
    flux2-gen --count 4                  # batch of 4

Full flag list and model setup notes follow:
==================================================================
HELP
        exec "$flux2" help ;;
esac

echo "prompt> (type/paste any number of lines, empty line to submit)" >&2
prompt=""
newline=$'\n'
while IFS= read -e -r line; do
    [ -n "$line" ] || break
    prompt="${prompt:+$prompt$newline}$line"
done
[ -n "$prompt" ] || { echo "no prompt given, aborting" >&2; exit 1; }

out="flux2_$(date +%Y%m%d_%H%M%S).png"
"$flux2" --prompt "$prompt" --output "$out" "$@"
echo "-> $(pwd)/$out"
