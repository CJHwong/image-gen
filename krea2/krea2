#!/usr/bin/env bash
# krea2 - wrapper around the locally-built krea2-harness Rust binary (Krea 2 on Apple MLX).
# Locates the built binary and forwards every arg verbatim. The binary reads per-mode
# weight dirs from env; this wrapper downloads nothing and injects nothing.
#
# Run `krea2 help` for usage. Build and weight downloads: krea2-harness/README.md.

set -eu

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
default_bin="$script_dir/krea2-harness/target/release/krea2"
bin="${KREA_BIN:-$default_bin}"

usage() {
    cat <<'EOF'
krea2 - Krea 2 image generation on Apple MLX (txt2img / img2img / edit / pose-control)

Build and weight downloads: krea2/krea2-harness/README.md
Per-mode flags: krea2 <subcommand> --help

ENV
  KREA_BIN            override the built binary path
  KREA_TURBO_Q4       Turbo q4 turnkey dir (txt2img/img2img default weights)
  KREA_RAW            Krea-2-Raw snapshot dir (edit)
  KREA_EDIT_LORA      krea2-identity-edit LoRA .safetensors (edit)
  KREA_TURBO_BF16     dense bf16 Krea-2-Turbo dir (control)
  KREA_POSE_OVERLAY   pose ControlNet overlay .safetensors (control)
  KREA_WEIGHTS        overrides the per-mode weights dir for every mode

EOF
    if [ -x "$bin" ]; then
        # The subcommand list comes from the binary, so it never drifts.
        "$bin" --help | sed -n '/^Commands:/,$p'
    else
        echo "Binary not built yet: cd krea2/krea2-harness && cargo build --release"
    fi
}

# Top-level help prints our usage. Subcommand --help (e.g. `krea2 txt2img --help`)
# falls through to the binary, which clap handles.
if [ "$#" -eq 0 ] || [ "${1:-}" = "help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ ! -x "$bin" ]; then
    echo "krea2: built binary not found at $bin" >&2
    echo "       run: cd krea2/krea2-harness && cargo build --release   (or set KREA_BIN)" >&2
    exit 1
fi

exec "$bin" "$@"
