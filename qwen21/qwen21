#!/usr/bin/env bash
# qwen21 - wrapper for Qwen-Image-2.1 generation on Apple MLX, via mflux
# (Python-MLX) through the PEP 723 script qwen21_gen.py. No harness to build and
# no Xcode: uv fetches mflux and its deps on first run, mflux fetches the weights.
# Every flag is forwarded to mflux's own parser; the script only fills in the
# defaults this repo wants (bf16, 40 steps, 1024 square) when you omit them.
#
# Run `qwen21 help` for full usage (weights, licence, flags, examples).

set -eu

usage() {
    cat <<'EOF'
qwen21 - Qwen-Image-2.1 generation and editing on Apple Silicon

  qwen21 <flags>        text-to-image and image-to-image, via mflux (MLX)
  qwen21 edit <flags>   instruction editing, up to 10 references, via diffusers (MPS)
  qwen21 server         a local web page for both, model resident, nothing saved

WEIGHTS
  Qwen/Qwen-Image-2.1 on HuggingFace, not gated, ~33 GB bf16. The first run
  downloads them into ~/.cache/huggingface (HF_HOME moves it). Both engines
  share the cache. Licence: Qwen Research License, research use only. Check
  it before you use any output commercially.

DEFAULTS (omit the flag to get these; pass it to override)
  (no -q flag)      bf16. -q 8 buys no speed or memory here; see qwen21_gen.py
  --steps 40        upstream's guidance-free default
  --width/--height  1024 square for text-to-image; i2i takes the input's size
  --output          qwen21.png in your cwd
  --auto-seeds 1    random seed, printed so you can reproduce it

FLAGS
  Forwarded verbatim to mflux. `qwen21 --help` lists all of them. First ones:
    --prompt            the prompt (required; or --prompt-file)
    --negative-prompt   enables true CFG; pair it with --guidance > 1
    --image PATH [STR]  reference image plus optional strength (default 0.4)
    --seed / --auto-seeds N
    -q                  0 for bf16 (default), or 8, 6, 5, 4, 3 to quantize
    --low-ram, --vae-tiling   lower peak memory at a speed cost
  `qwen21 edit --help` and `qwen21 server --help` list their own flags.

NOTES
  - Size is the speed dial: 512 runs 3.3x faster than 1024 and saves 10 GB.
  - Quote the exact text you want in the image. Unspecified text comes out as
    fake glyphs.
  - Run one generation at a time. Two at once slow each other 2.5x.
  - The edit path runs its VAE encode on CPU, because MPS miscomputes it.
    See MPS-VAE-ENCODE.md.
  - Edit output can carry alpha. Generate output is RGB only. No LoRA.
  - The server binds 127.0.0.1. It never writes the prompt or the image to
    disk, and it loads htmx from a CDN with no prompt data in the request.

EXAMPLES
  qwen21 --prompt "a beaver building a dam, photorealistic, golden hour"
  qwen21 --prompt "a red apple" --seed 42 --output apple.png
  qwen21 --prompt "make it winter" --image ref.png 0.6 --output winter.png
  qwen21 --prompt "a red apple" --auto-seeds 4 --output "apple_{seed}.png"
  qwen21 edit --prompt "make it night, lights on" --image room.png
  qwen21 server --port 9000

Measurements behind every default live next to the code they justify:
qwen21_gen.py (precision, size, text), qwen21_server.py (server, edit cost).
EOF
}

# realpath follows a ~/.local/bin symlink, so the sibling scripts are found.
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

# `qwen21 help` prints this wrapper's usage. `--help` falls through to mflux's
# own parser, which is authoritative for the flag list.
case "${1:-}" in
    help) usage; exit 0 ;;
    edit) shift; exec uv run "$script_dir/qwen21_edit.py" "$@" ;;
    server) shift; exec uv run "$script_dir/qwen21_server.py" "$@" ;;
esac

exec uv run "$script_dir/qwen21_gen.py" "$@"
